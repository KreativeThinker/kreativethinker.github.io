---
import Heading from "../../components/base/Heading.astro";
import Screen from "../../components/compound/Screen.astro";
import ProjectScreen from "../compound/ProjectScreen.astro";
---

<Screen
  anchor="projects"
  background="bg-background"
  color="text-text"
  next_section="project-1"
>
  <div class="flex w-full flex-col items-center justify-center">
    <Heading
      color="text-accent"
      classList="font-bold uppercase text-center mb-4"
    >
      Projects
    </Heading>
    <div
      class="flex flex-col justify-evenly gap-8 p-8 md:w-3/4 md:flex-row lg:w-1/2"
    >
      <p class="text-accent">
        Most of my projects are web development centered with my prefered stack
        being FastAPI, PostgreSQL, React and Tailwind with Docker for
        deployments. Beyond web development, I have indulged in app development,
        computer vision, and DevOps, often branching into new fields through
        minor projects.
      </p>
    </div>
    <p class="text-center">
      Some Projects are below. View more on my <i class="fa-brands fa-github"
      ></i>
      <a href="https://github.com/KreativeThinker" class="underline">Github</a>
    </p>
  </div>
</Screen>

<ProjectScreen
  title="Zeta"
  anchor="project-1"
  next_section="project-2"
  technologies={["Go", "WireGuard", "gRPC", "Kotlin", "Docker"]}
  github_link="https://github.com/KreativeThinker/zeta"
  deployment=""
>
  <p class="leading-relaxed">
    An exploratory project into computer networking. It is a self-hostable mesh
    VPN built on WireGuard: enroll any Linux device or Android phone with a
    preauth key and it joins a private mesh network, with a coordinator that
    stays out of the data path once peers know each other's keys.
  </p>
  <ul class="mt-2 pl-5">
    <li class="list-disc">
      Coordinator handles enrollment, key distribution, and network map updates
      over gRPC
    </li>
    <li class="list-disc">
      Direct peer-to-peer WireGuard tunnels for data — no relay
    </li>
    <li class="list-disc">Linux agent plus a native Android client</li>
  </ul>
</ProjectScreen>

<ProjectScreen
  title="PwnCore"
  anchor="project-2"
  github_link="https://github.com/lugvitc/pwncore"
  next_section="project-3"
  technologies={["Python", "FastAPI", "TortoiseORM", "Docker"]}
  deployment=""
>
  <p class="leading-relaxed">
    A Capture The Flag, Cyber-Security backend designed for heavy traffic and
    cheating-free competitions. Tested for 10000+ concurrent users without lag
    or overload.
  </p>
  <ul class="mt-2 pl-5">
    <li class="list-disc">
      Deploys CTF challenges using isolated docker containers
    </li>
    <li class="list-disc">
      Supports dynamic points and dynamic flags, solving prevailing problems of
      "flag sharing" amongst participants.
    </li>
    <li class="list-disc">
      Optimized microservices for static CTF deployments
    </li>
    <li class="list-disc">
      Supports standard Jeopardy-Style CTFs along with an innovative Free For
      All, Cyber War mode
    </li>
  </ul>
</ProjectScreen>

<ProjectScreen
  title="DyNaGO"
  anchor="project-3"
  github_link="https://github.com/KreativeThinker/dynago"
  next_section="contact"
  technologies={["OpenCV", "TensorFlow", "MediaPipe"]}
  deployment=""
>
  <p class="leading-relaxed">
    An AI-powered, extremely light-weight, natural gesture recognition based
    Human Computer Interfacing (HCI) tool. Allows users to control their system
    effortlessly with hand gestures detected via a standard webcam. This
    eliminates the reliance on traditional input devices like keyboards and
    mouse (pl), enhancing accessibility and user experience.
  </p>
</ProjectScreen>
