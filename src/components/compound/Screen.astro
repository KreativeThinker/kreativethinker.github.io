---
import ScrollButton from "../base/ScrollButton.astro";
import Separator from "../base/Separator.astro";

interface Props {
  anchor: string;
  background: string;
  color: string;
  next_section: string;
  invert?: boolean;
  rotate?: boolean;
  separator?: boolean;
  hideWave?: boolean;
}

const { anchor, background, color, next_section, invert, rotate, separator, hideWave } =
  Astro.props;

const cursorClass = invert ? "cursor-brand-inverted" : "cursor-brand";
---

<div
  id={anchor}
  class={`flex flex-col snap-center items-center justify-center relative w-screen h-screen overflow-hidden ${background} ${color} ${cursorClass}`}
>
  {
    !hideWave && separator && (
      <Separator
        classList="absolute top-0 rotate-180 h-[40%] w-auto md:w-full md:h-auto md:-translate-y-1/3 lg:-translate-y-1/2"
        invert={invert}
      />
    )
  }
  <ScrollButton section={next_section} {invert} {rotate} />
  {
    !hideWave && (
      <Separator
        classList="absolute bottom-0 h-[40%] w-auto md:w-full md:h-auto md:translate-y-1/3 lg:translate-y-1/2"
        invert={invert}
      />
    )
  }
  <slot />
</div>
